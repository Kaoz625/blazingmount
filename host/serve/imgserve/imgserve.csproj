<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- imgserve: read-only HTTP Range server for the FILES INSIDE .ffpfsc game images on a drive of the
       machine it runs on. It decodes the PFSC blocks and the inner exFAT/UFS2 filesystem on demand using
       ps-neighborhood's PS5PKGTool.Ffpfsc (GPL-3.0, an EXTERNAL build dependency - see CREDITS.md), so a
       game stays ONE compressed image on the drive and a PS5 can still read any inner file range over the
       LAN. Build with build.sh and point FFPFSC_SRC at your ps-neighborhood checkout. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>imgserve</AssemblyName>
    <RootNamespace>ImgServe</RootNamespace>
    <FfpfscProj Condition="'$(FfpfscProj)' == ''">$(HOME)/.blazing/pkg-to-image/src/converter/vendor/PS5PKGTool.Ffpfsc/PS5PKGTool.Ffpfsc.csproj</FfpfscProj>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(FfpfscProj)" />
  </ItemGroup>
</Project>
