<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- imgserve (tokon-mod-3, 20 Oct 2026): read-only HTTP Range server for the FILES INSIDE .ffpfsc game images that live on a drive of the machine it runs on
       (mac1: /Volumes/Untitled, /Volumes/My Book). It decodes the PFSC blocks and the inner exFAT/UFS2 filesystem on demand with ps-neighborhood's
       PS5PKGTool.Ffpfsc (GPL-3.0, like tools/tokonport/imgpull), so a game stays ONE compressed image on the drive and a PS5 can still read any inner
       file range over the LAN (the link of HOOK-PLAN job 2). Build with build.sh (it points FfpfscProj at the vendored source). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>imgserve</AssemblyName>
    <RootNamespace>ImgServe</RootNamespace>
    <FfpfscProj Condition="'$(FfpfscProj)' == ''">$(HOME)/.blazing/pkg-to-image/src/converter/vendor/PS5PKGTool.Ffpfsc/PS5PKGTool.Ffpfsc.csproj</FfpfscProj>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(FfpfscProj)" />
  </ItemGroup>
</Project>
