<?xml version="1.0" encoding="UTF-8"?>
<!-- User LaunchAgent: keeps the visible catalog-server Terminal up and restores it after a reboot.
     Install: edit the keeper path below to your checkout, copy to ~/Library/LaunchAgents/, then
     `launchctl load -w ~/Library/LaunchAgents/com.blazingmount.host.plist`. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.blazingmount.host</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string>
    <string>REPLACE/WITH/ABSOLUTE/PATH/TO/install/host-autostart/catalog-keeper.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>60</integer>
</dict></plist>
